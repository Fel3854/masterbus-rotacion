# ============================================
# Variables de entorno globales
# Copia este archivo como .env y completa los valores
# ============================================

# APIs externas
MASTERBUS_API_URL=https://traficonuevo.masterbus.net/api/v1/auto/e

# Supabase — obtener en https://supabase.com → Project Settings → API
# SUPABASE_URL: Project URL (ej: https://xxxx.supabase.co)
# SUPABASE_KEY: anon/public key (segura para uso en cliente)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-aqui

# SMTP — Servidor de correo corporativo
SMTP_HOST=smtp.tu-servidor.com
SMTP_PORT=587
SMTP_USER=usuario@empresa.com
SMTP_PASSWORD=tu-contraseña-aqui
SMTP_USE_TLS=true

# RRHH — Destinatario de alertas
RRHH_EMAIL=rrhh@empresa.com

# Alerta Período de Prueba — Rango de días para "mes 5"
ALERTA_DIA_MIN=150
ALERTA_DIA_MAX=180

# Configuración general
DEBUG=false
LOG_LEVEL=INFO

# Dashboard de Control — heartbeat (Fase 3)
# El batch reporta su "última corrida" al panel (heartbeats/rotacion.json).
# GH_TOKEN: Personal Access Token *fine-grained* con permiso "Contents: Read and write"
# SOLO sobre el repo dashboard-control. Generar en:
#   GitHub → Settings → Developer settings → Fine-grained tokens.
GH_TOKEN=tu-pat-aqui
# Opcionales (defaults: Fel3854/dashboard-control y main):
# HEARTBEAT_REPO=Fel3854/dashboard-control
# HEARTBEAT_BRANCH=main
